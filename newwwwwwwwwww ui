                create("UICorner", {
                    Parent = Fill,
                    CornerRadius = UDim.new(1, 0)
                })
                
                local dragging = false
                
                local function update(input)
                    local pos = math.clamp((input.Position.X - SliderBG.AbsolutePosition.X) / SliderBG.AbsoluteSize.X, 0, 1)
                    local val = math.floor(min + (max - min) * pos)
                    
                    tween(Fill, {Size = UDim2.new(pos, 0, 1, 0)}, 0.08)
                    ValueText.Text = tostring(val)
                    library.pointers[flag] = val
                    callback(val)
                end
                
                SliderBG.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        dragging = true
                        update(input)
                    end
                end)
                
                UserInputService.InputChanged:Connect(function(input)
                    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                        update(input)
                    end
                end)
                
                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        dragging = false
                    end
                end)
                
                section:Resize()
                
                return {
                    Set = function(self, val)
                        val = math.clamp(val, min, max)
                        local pos = (val - min) / (max - min)
                        tween(Fill, {Size = UDim2.new(pos, 0, 1, 0)})
                        ValueText.Text = tostring(val)
                        library.pointers[flag] = val
                        callback(val)
                    end,
                    Get = function(self)
                        return library.pointers[flag]
                    end
                }
            end
            
            -- Dropdown Element
            function section:Dropdown(name, options, multi, flag, callback)
                local Item = create("Frame", {
                    Parent = Container,
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 0, 40)
                })
                
                create("TextLabel", {
                    Parent = Item,
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 0, 14),
                    Font = Enum.Font.Gotham,
                    Text = name,
                    TextColor3 = theme.textdark,
                    TextSize = 12,
                    TextXAlignment = Enum.TextXAlignment.Left
                })
                
                local Drop = create("TextButton", {
                    Parent = Item,
                    BackgroundColor3 = theme.background,
                    Position = UDim2.new(0, 0, 0, 18),
                    Size = UDim2.new(1, 0, 0, 24),
                    Text = ""
                })
                
                create("UIStroke", {
                    Parent = Drop,
                    Color = theme.outline,
                    Thickness = 1,
                    Transparency = 0.5
                })
                
                create("UICorner", {
                    Parent = Drop,
                    CornerRadius = UDim.new(0, 4)
                })
                
                local DropText = create("TextLabel", {
                    Parent = Drop,
                    BackgroundTransparency = 1,
                    Position = UDim2.new(0, 8, 0, 0),
                    Size = UDim2.new(1, -24, 1, 0),
                    Font = Enum.Font.Gotham,
                    Text = multi and "None" or options[1],
                    TextColor3 = theme.textdark,
                    TextSize = 11,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextTruncate = Enum.TextTruncate.AtEnd
                })
                
                create("TextLabel", {
                    Parent = Drop,
                    BackgroundTransparency = 1,
                    Position = UDim2.new(1, -18, 0.5, -5),
                    Size = UDim2.new(0, 10, 0, 10),
                    Font = Enum.Font.GothamBold,
                    Text = "▼",
                    TextColor3 = theme.textdark,
                    TextSize = 8
                })
                
                library.pointers[flag] = multi and {} or options[1]
                
                -- Add dropdown functionality here (truncated for brevity)
                
                section:Resize()
            end
            
            -- ColorPicker Element
            function section:ColorPicker(name, default, flag, callback)
                local Item = create("Frame", {
                    Parent = Container,
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 0, 18)
                })
                
                create("TextLabel", {
                    Parent = Item,
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, -26, 1, 0),
                    Font = Enum.Font.Gotham,
                    Text = name,
                    TextColor3 = theme.textdark,
                    TextSize = 12,
                    TextXAlignment = Enum.TextXAlignment.Left
                })
                
                local ColorBox = create("TextButton", {
                    Parent = Item,
                    BackgroundColor3 = default,
                    Position = UDim2.new(1, -20, 0.5, -7),
                    Size = UDim2.new(0, 20, 0, 14),
                    Text = ""
                })
                
                create("UICorner", {
                    Parent = ColorBox,
                    CornerRadius = UDim.new(0, 3)
                })
                
                create("UIStroke", {
                    Parent = ColorBox,
                    Color = theme.outline,
                    Thickness = 1,
                    Transparency = 0.5
                })
                
                library.pointers[flag] = default
                
                ColorBox.MouseButton1Click:Connect(function()
                    local h, s, v = default:ToHSV()
                    h = (h + 0.15) % 1
                    local newColor = Color3.fromHSV(h, 0.85, 0.95)
                    tween(ColorBox, {BackgroundColor3 = newColor})
                    library.pointers[flag] = newColor
                    callback(newColor)
                end)
                
                section:Resize()
            end
            
            -- Button Element
            function section:Button(name, callback)
                local Item = create("Frame", {
                    Parent = Container,
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 0, 26)
                })
                
                local Btn = create("TextButton", {
                    Parent = Item,
                    BackgroundColor3 = theme.accent,
                    Size = UDim2.new(1, 0, 1, 0),
                    Font = Enum.Font.GothamBold,
                    Text = name,
                    TextColor3 = theme.text,
                    TextSize = 12
                })
                
                create("UICorner", {
                    Parent = Btn,
                    CornerRadius = UDim.new(0, 5)
                })
                
                Btn.MouseEnter:Connect(function()
                    tween(Btn, {BackgroundColor3 = Color3.fromRGB(255, 90, 90)})
                end)
                
                Btn.MouseLeave:Connect(function()
                    tween(Btn, {BackgroundColor3 = theme.accent})
                end)
                
                Btn.MouseButton1Click:Connect(callback)
                
                section:Resize()
            end
            
            return section
        end
        
        table.insert(window.tabs, tab)
        return tab
    end
    
    return window
end

return library
