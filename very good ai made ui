function library:createConfig()
    makefolder("CustomUIConfigs")
    local name = library.flags["config_name"] or "config"
    local data = {}
    for flag, value in pairs(library.flags) do
        if type(value) == "Color3" then
            data[flag] = {value.R, value.G, value.B}
        elseif type(value) == "EnumItem" then
            data[flag] = tostring(value)
        else
            data[flag] = value
        end
    end
    writefile("CustomUIConfigs/"..name..".cfg", game:GetService("HttpService"):JSONEncode(data))
    library:Notify("Config saved: "..name)
end

function library:loadConfig()
    local name = library.flags["config_box"]
    if not isfile(name) then return library:Notify("Config not found") end
    local data = game:GetService("HttpService"):JSONDecode(readfile(name))
    for flag, value in pairs(data) do
        if library.flags[flag] ~= nil then
            if type(value) == "table" and #value == 3 then
                library.flags[flag] = Color3.new(value[1], value[2], value[3])
            else
                library.flags[flag] = value
            end
        end
    end
    library:Notify("Config loaded")
end

function library:refreshConfigs()
    local files = listfiles("CustomUIConfigs")
    if library.options and library.options.config_box then
        library.options.config_box.refresh(files)
    end
end

UserInputService.InputBegan:Connect(function(input)
    if input.KeyCode == library.keybind then
        Window.Visible = not Window.Visible
        for _, v in pairs(library.toInvis) do
            v.Visible = false
        end
    end
end)

