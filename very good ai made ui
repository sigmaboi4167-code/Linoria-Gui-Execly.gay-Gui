                hue.Position = UDim2.new(1, -25, 0, 5)
                hue.Image = "rbxassetid://2615692420"
                
                local saturation = Instance.new("ImageLabel")
                saturation.Parent = pickerFrame
                saturation.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                saturation.Size = UDim2.new(1, -35, 1, -10)
                saturation.Position = UDim2.new(0, 5, 0, 5)
                saturation.Image = "rbxassetid://2615689005"
                
                local colorPreview = Instance.new("Frame")
                colorPreview.Parent = pickerFrame
                colorPreview.BackgroundColor3 = args.color or library.colors.accent
                colorPreview.BorderColor3 = library.colors.accent
                colorPreview.BorderSizePixel = 1
                colorPreview.Position = UDim2.new(0, 5, 1, -20)
                colorPreview.Size = UDim2.new(0, 30, 0, 15)
                
                library.flags[args.flag] = args.color or library.colors.accent
                table.insert(library.toInvis, pickerFrame)
                
                colorButton.MouseButton1Click:Connect(function()
                    pickerFrame.Visible = not pickerFrame.Visible
                end)
                
                colorButton.MouseEnter:Connect(function()
                    TweenService:Create(colorFrame, TweenInfo.new(0.2), {BorderColor3 = library.colors.accent}):Play()
                end)
                
                colorButton.MouseLeave:Connect(function()
                    TweenService:Create(colorFrame, TweenInfo.new(0.2), {BorderColor3 = Color3.fromRGB(25, 25, 25)}):Play()
                end)
                
                return toggleMethods
            end
            
            return toggleMethods
        end
        
        function groupMethods:addSlider(args)
            local frame = Instance.new("Frame")
            frame.Name = args.flag.."Slider"
            frame.Parent = groupContent
            frame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            frame.BackgroundTransparency = 1
            frame.Size = UDim2.new(1, -10, 0, 35)
            
            local label = Instance.new("TextLabel")
            label.Parent = frame
            label.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            label.BackgroundTransparency = 1
            label.Position = UDim2.new(0, 5, 0, 0)
            label.Size = UDim2.new(0.7, 0, 0, 15)
            label.Font = Enum.Font.Code
            label.Text = args.text or args.flag
            label.TextColor3 = library.colors.textDim
            label.TextSize = 9
            label.TextXAlignment = Enum.TextXAlignment.Left
            
            local valueLabel = Instance.new("TextLabel")
            valueLabel.Parent = frame
            valueLabel.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            valueLabel.BackgroundTransparency = 1
            valueLabel.Position = UDim2.new(0.7, 0, 0, 0)
            valueLabel.Size = UDim2.new(0.3, -5, 0, 15)
            valueLabel.Font = Enum.Font.Code
            valueLabel.Text = tostring(args.default or 0)..(args.suffix or "")
            valueLabel.TextColor3 = library.colors.accent
            valueLabel.TextSize = 9
            valueLabel.TextXAlignment = Enum.TextXAlignment.Right
            
            local sliderBg = Instance.new("Frame")
            sliderBg.Parent = frame
            sliderBg.BackgroundColor3 = library.colors.foreground
            sliderBg.BorderColor3 = Color3.fromRGB(25, 25, 25)
            sliderBg.BorderSizePixel = 1
            sliderBg.Position = UDim2.new(0, 5, 0, 18)
            sliderBg.Size = UDim2.new(1, -10, 0, 8)
            
            local sliderFill = Instance.new("Frame")
            sliderFill.Parent = sliderBg
            sliderFill.BackgroundColor3 = library.colors.accent
            sliderFill.BorderSizePixel = 0
            sliderFill.Size = UDim2.new((args.default or 0) / args.max, 0, 1, 0)
            
            local sliderButton = Instance.new("TextButton")
            sliderButton.Parent = sliderBg
            sliderButton.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            sliderButton.BackgroundTransparency = 1
            sliderButton.Size = UDim2.new(1, 0, 1, 0)
            sliderButton.Text = ""
            
            local dragging = false
            local value = args.default or 0
            library.flags[args.flag] = value
            
            local function updateValue(newValue)
                value = math.clamp(newValue, args.min or 0, args.max)
                sliderFill.Size = UDim2.new(value / args.max, 0, 1, 0)
                valueLabel.Text = tostring(value)..(args.suffix or "")
                library.flags[args.flag] = value
                if args.callback then args.callback(value) end
            end
            
            sliderButton.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = true
                    local pos = Mouse.X - sliderBg.AbsolutePosition.X
                    local percent = math.clamp(pos / sliderBg.AbsoluteSize.X, 0, 1)
                    updateValue(args.min + (args.max - args.min) * percent)
                end
            end)
            
            sliderButton.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = false
                end
            end)
            
            UserInputService.InputChanged:Connect(function(input)
                if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                    local pos = Mouse.X - sliderBg.AbsolutePosition.X
                    local percent = math.clamp(pos / sliderBg.AbsoluteSize.X, 0, 1)
                    updateValue(args.min + (args.max - args.min) * percent)
                end
            end)
            
            sliderButton.MouseEnter:Connect(function()
                TweenService:Create(sliderBg, TweenInfo.new(0.2), {BorderColor3 = library.colors.accent}):Play()
            end)
            
            sliderButton.MouseLeave:Connect(function()
                TweenService:Create(sliderBg, TweenInfo.new(0.2), {BorderColor3 = Color3.fromRGB(25, 25, 25)}):Play()
            end)
            
