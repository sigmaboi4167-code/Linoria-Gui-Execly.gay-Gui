function Fonts:Register_Font(Name, Weight, Style, Asset)
    -- 1. Ensure the raw font file (e.g., .ttf) exists
    if not isfile(Asset.Id) then
        writefile(Asset.Id, crypt.base64.decode(Asset.Font))
    end

    -- 2. Define the path for the Roblox Font Configuration file
    local fontConfigPath = Name .. ".font"

    -- 3. Construct the JSON data 
    -- 'assetId' inside here must point to the actual font file
    local Data = {
        name = Name,
        faces = {
            {
                name = "Regular",
                weight = Weight,
                style = Style,
                assetId = getcustomasset(Asset.Id), -- Points to the .ttf/.txt file
            },
        },
    }

    -- 4. Write the config file
    writefile(fontConfigPath, HttpService:JSONEncode(Data))

    -- 5. Return the custom asset URI of the .font file itself
    return getcustomasset(fontConfigPath)
end

