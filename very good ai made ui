        end
        
        return groupMethods
    end
    
    tabButton.MouseButton1Click:Connect(function()
        for _, btn in pairs(library.tabbuttons) do
            btn.TextColor3 = library.colors.textDim
        end
        for _, page in pairs(library.tabs) do
            page.Visible = false
        end
        tabButton.TextColor3 = library.colors.accent
        tabPage.Visible = true
    end)
    
    table.insert(library.tabbuttons, tabButton)
    table.insert(library.tabs, tabPage)
    
    TabContainer.CanvasSize = UDim2.new(0, 0, 0, #library.tabbuttons * 27)
    
    return groups
