-- Create Snowfall Particle System
local function createSnowfall()
    local snowGui = CloneScreenGui
    snowGui.Name = "SnowfallOverlay"
    snowGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    
    local snowContainer = Instance.new("Frame", snowGui)
    snowContainer.Name = "SnowContainer"
    snowContainer.BackgroundTransparency = 1
    snowContainer.Size = UDim2.new(1, 0, 1, 0)
    snowContainer.ZIndex = 1
    
    local snowParticles = {}
    local particleCount = 60
    
    for i = 1, particleCount do
        local particle = Instance.new("Frame", snowContainer)
        particle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        particle.BorderSizePixel = 0
        particle.Size = UDim2.new(0, math.random(2, 5), 0, math.random(2, 5))
        particle.Position = UDim2.new(math.random(0, 100) / 100, 0, math.random(-10, 0) / 10, 0)
        particle.BackgroundTransparency = math.random(40, 80) / 100
        
        -- Add corner radius for softer appearance
        local corner = Instance.new("UICorner", particle)
        corner.CornerRadius = UDim.new(1, 0)
        
        -- Glow effect for particles
        local glow = Instance.new("UIStroke", particle)
        glow.Color = Color3.fromRGB(255, 255, 255)
        glow.Thickness = 0.5
        glow.Transparency = 0.7
        
        table.insert(snowParticles, {
            frame = particle,
            speed = math.random(10, 30) / 100,
            sway = math.random(-5, 5) / 100,
            yPos = math.random(-10, 0) / 10
        })
    end
    
    -- Animate snowfall
    task.spawn(function()
        while true do
            task.wait(0.03)
            for _, particle in ipairs(snowParticles) do
                particle.yPos = particle.yPos + particle.speed
                local xPos = particle.frame.Position.X.Scale + particle.sway
                
                if particle.yPos > 1.1 then
                    particle.yPos = -0.1
                    particle.frame.Position = UDim2.new(math.random(0, 100) / 100, 0, -0.1, 0)
                else
                    particle.frame.Position = UDim2.new(xPos, 0, particle.yPos, 0)
                end
                
                -- Vary opacity
                local opacity = math.sin(particle.yPos * 6.28) * 0.2 + 0.5
                particle.frame.BackgroundTransparency = 0.6 + (opacity * 0.2)
            end
        end
    end)
    
    return snowGui
end

