function library:Notify(text, time)
    time = time or 3
    local notif = Instance.new("Frame")
    notif.Parent = UI
    notif.BackgroundColor3 = library.colors.background
    notif.BorderColor3 = library.colors.accent
    notif.BorderSizePixel = 1
    notif.Position = UDim2.new(1, -210, 0, 10)
    notif.Size = UDim2.new(0, 200, 0, 0)
    notif.ClipsDescendants = true
    
    local inner = Instance.new("Frame")
    inner.Parent = notif
    inner.BackgroundColor3 = library.colors.foreground
    inner.BorderColor3 = Color3.fromRGB(25, 25, 25)
    inner.BorderSizePixel = 1
    inner.Position = UDim2.new(0, 1, 0, 1)
    inner.Size = UDim2.new(1, -2, 1, -2)
    
    local label = Instance.new("TextLabel")
    label.Parent = inner
    label.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    label.BackgroundTransparency = 1
    label.Size = UDim2.new(1, -10, 1, 0)
    label.Position = UDim2.new(0, 5, 0, 0)
    label.Font = Enum.Font.Code
    label.Text = text
    label.TextColor3 = library.colors.text
    label.TextSize = 9
    label.TextWrapped = true
    
    local line = Instance.new("Frame")
    line.Parent = inner
    line.BackgroundColor3 = library.colors.accent
    line.BorderSizePixel = 0
    line.Position = UDim2.new(0, 0, 1, -2)
    line.Size = UDim2.new(1, 0, 0, 2)
    
    local textSize = label.TextBounds
    notif.Size = UDim2.new(0, 200, 0, textSize.Y + 10)
    
    TweenService:Create(notif, TweenInfo.new(0.5), {Position = UDim2.new(1, -210, 0, 10)}):Play()
    TweenService:Create(line, TweenInfo.new(time, Enum.EasingStyle.Linear), {Size = UDim2.new(0, 0, 0, 2)}):Play()
    
    task.wait(time)
    TweenService:Create(notif, TweenInfo.new(0.5), {Position = UDim2.new(1, 10, 0, 10)}):Play()
    task.wait(0.5)
    notif:Destroy()
end

