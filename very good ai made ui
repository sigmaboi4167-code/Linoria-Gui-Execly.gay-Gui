local Library = loadstring(game:HttpGet("raw link here"))()

-- Create tabs (they'll appear on the RIGHT side)
local Tabs = {
    Main = Library:addTab("Main"),
    Combat = Library:addTab("Combat"),
    Visuals = Library:addTab("Visuals"),
    Settings = Library:addTab("Settings")
}

-- Create groups
local AimGroup = Tabs.Combat:createGroup("left", "Aimbot")
local MiscGroup = Tabs.Combat:createGroup("right", "Misc")

-- Add toggle
AimGroup:addToggle({
    text = "Enable Aimbot",
    flag = "aimbot",
    default = false,
    callback = function(state)
        print("Aimbot:", state)
    end
})

-- Add toggle with keybind
AimGroup:addToggle({
    text = "Aimbot Key",
    flag = "aimbot_toggle",
    default = false
}):addKeybind({
    text = "Aimbot",
    flag = "aimbot_key",
    key = Enum.KeyCode.Q
})

-- Add slider
AimGroup:addSlider({
    text = "Smoothness",
    flag = "smooth",
    min = 1,
    max = 100,
    default = 50,
    suffix = "%",
    callback = function(value)
        print("Smooth:", value)
    end
})

-- Add button
MiscGroup:addButton({
    text = "Refresh",
    callback = function()
        print("Refreshed!")
    end
})

-- Add label
MiscGroup:addLabel({
    text = "Status: Ready"
})

-- Show keybinds window
Library:visualize(true)
