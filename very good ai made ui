            local toggleBox = Instance.new("Frame")
            toggleBox.Parent = frame
            toggleBox.BackgroundColor3 = library.colors.foreground
            toggleBox.BorderColor3 = Color3.fromRGB(25, 25, 25)
            toggleBox.BorderSizePixel = 1
            toggleBox.Position = UDim2.new(0, 5, 0.2, 0)
            toggleBox.Size = UDim2.new(0, 15, 0, 15)
            
            local toggleInner = Instance.new("Frame")
            toggleInner.Parent = toggleBox
            toggleInner.BackgroundColor3 = library.colors.accent
            toggleInner.BorderColor3 = Color3.fromRGB(25, 25, 25)
            toggleInner.BorderSizePixel = 1
            toggleInner.Size = UDim2.new(1, 0, 1, 0)
            toggleInner.BackgroundTransparency = args.default and 0 or 1
            
            local label = Instance.new("TextLabel")
            label.Parent = frame
            label.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            label.BackgroundTransparency = 1
            label.Position = UDim2.new(0, 25, 0, 0)
            label.Size = UDim2.new(1, -30, 1, 0)
            label.Font = Enum.Font.Code
            label.Text = args.text or args.flag
            label.TextColor3 = args.risky and library.colors.risky or library.colors.textDim
            label.TextSize = 9
            label.TextXAlignment = Enum.TextXAlignment.Left
            
            local button = Instance.new("TextButton")
            button.Parent = frame
            button.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            button.BackgroundTransparency = 1
            button.Size = UDim2.new(1, 0, 1, 0)
            button.Text = ""
            
            local state = args.default or false
            library.flags[args.flag] = state
            
            local function updateState(newState)
                state = newState
                library.flags[args.flag] = state
                toggleInner.BackgroundTransparency = state and 0 or 1
                if args.risky then
                    label.TextColor3 = state and library.colors.risky or library.colors.textDim
                else
                    label.TextColor3 = state and library.colors.text or library.colors.textDim
                end
                if args.callback then args.callback(state) end
            end
            
            button.MouseButton1Click:Connect(function()
                if not library.colorpicking then
                    updateState(not state)
                end
            end)
            
            button.MouseEnter:Connect(function()
                TweenService:Create(toggleBox, TweenInfo.new(0.2), {BorderColor3 = library.colors.accent}):Play()
            end)
            
            button.MouseLeave:Connect(function()
                TweenService:Create(toggleBox, TweenInfo.new(0.2), {BorderColor3 = Color3.fromRGB(25, 25, 25)}):Play()
            end)
            
            groupBox.Size = UDim2.new(0.5, -10, 0, groupBox.Size.Y.Offset + 22)
            tabPage.CanvasSize = UDim2.new(0, 0, 0, tabPage.CanvasSize.Y.Offset + 22)
            
            local toggleMethods = {}
            
            function toggleMethods:addKeybind(args)
                local keyFrame = Instance.new("Frame")
                keyFrame.Parent = frame
                keyFrame.BackgroundColor3 = library.colors.foreground
                keyFrame.BorderColor3 = Color3.fromRGB(25, 25, 25)
                keyFrame.BorderSizePixel = 1
                keyFrame.Position = UDim2.new(0.7, 0, 0.15, 0)
                keyFrame.Size = UDim2.new(0, 40, 0, 15)
                
                local keyButton = Instance.new("TextButton")
                keyButton.Parent = keyFrame
                keyButton.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                keyButton.BackgroundTransparency = 1
                keyButton.Size = UDim2.new(1, 0, 1, 0)
                keyButton.Font = Enum.Font.Code
                keyButton.Text = tostring(args.key or "None"):split(".")[3] or "None"
                keyButton.TextColor3 = library.colors.textDim
                keyButton.TextSize = 8
                
                local keybindLabel = Instance.new("TextLabel")
                keybindLabel.Parent = KeybindList
                keybindLabel.BackgroundColor3 = library.colors.foreground
                keybindLabel.BorderColor3 = Color3.fromRGB(25, 25, 25)
                keybindLabel.BorderSizePixel = 1
                keybindLabel.Size = UDim2.new(1, -4, 0, 16)
                keybindLabel.Font = Enum.Font.Code
                keybindLabel.Text = (args.text or args.flag)..": ["..(tostring(args.key):split(".")[3] or "None").."]"
                keybindLabel.TextColor3 = library.colors.textDim
                keybindLabel.TextSize = 8
                keybindLabel.RichText = true
                
                library.flags[args.flag] = args.key or Enum.KeyCode.Unknown
                
                KeybindList.Size = UDim2.new(1.012, 0, 0, KeybindList.Size.Y.Offset + 18)
                
                local rebinding = false
                
                keyButton.MouseButton1Click:Connect(function()
                    if library.colorpicking then return end
                    rebinding = true
                    keyButton.Text = "..."
                    keyButton.TextColor3 = library.colors.accent
                    
                    local connection
                    connection = UserInputService.InputBegan:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 then return end
                        local key = input.KeyCode ~= Enum.KeyCode.Unknown and input.KeyCode or input.UserInputType
                        if key ~= Enum.KeyCode.Unknown then
                            library.flags[args.flag] = key
                            keyButton.Text = tostring(key):split(".")[3] or "None"
                            keyButton.TextColor3 = library.colors.textDim
                            keybindLabel.Text = (args.text or args.flag)..": ["..(tostring(key):split(".")[3] or "None").."]"
                            rebinding = false
                            connection:Disconnect()
                        end
                    end)
                end)
                
                keyButton.MouseEnter:Connect(function()
                    TweenService:Create(keyFrame, TweenInfo.new(0.2), {BorderColor3 = library.colors.accent}):Play()
                end)
                
                keyButton.MouseLeave:Connect(function()
                    TweenService:Create(keyFrame, TweenInfo.new(0.2), {BorderColor3 = Color3.fromRGB(25, 25, 25)}):Play()
                end)
                
                return toggleMethods
            end
            
            function toggleMethods:addColorpicker(args)
                local colorFrame = Instance.new("Frame")
                colorFrame.Parent = frame
                colorFrame.BackgroundColor3 = library.colors.foreground
                colorFrame.BorderColor3 = Color3.fromRGB(25, 25, 25)
                colorFrame.BorderSizePixel = 1
