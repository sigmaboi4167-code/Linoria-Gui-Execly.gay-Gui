                elseif k == "Rounding" then
                        self._frame._corner.CornerRadius = _udimnew(0, v);
                elseif k == "Size" then
                        self._frame.Size = _udim2fromoffset(v.X, v.Y);
                elseif k == "Transparency" then
                        self._frame.ImageTransparency = 1 - v;
                elseif k == "Uri" then
                        self:_newImage(v, true);
